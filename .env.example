VITE_API_BASE_URL=http://YOUR_SERVER_IP/api/v1

# ── Web Push (Firebase Cloud Messaging) ──
# Isi dari Firebase Console → Project Settings → General (Web app) & Cloud Messaging.
# Kosongkan jika belum dipakai — tombol "Aktifkan Notifikasi" otomatis tersembunyi.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# VAPID key: Project Settings → Cloud Messaging → Web Push certificates → Key pair
VITE_FIREBASE_VAPID_KEY=
